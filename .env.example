# --- Backend (read from the process environment, not from this file) ---
# Required. Shared token clients must present. Use any value you like.
AUTH_TOKEN=change-me
# Optional:
# ADDR=:8080                              # or PORT=8080
# ALLOWED_ORIGINS=http://localhost:3000   # comma-separated; "*" allows any
# SESSION_SECRET=                         # signs resume tokens; random per process if unset

# --- Frontend (copy this file to .env.local) ---
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
# Must match the backend's AUTH_TOKEN. NEXT_PUBLIC_ values are bundled into the
# browser build, so this is a shared demo token, not a secret.
NEXT_PUBLIC_AUTH_TOKEN=change-me
